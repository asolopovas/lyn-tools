{
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --exclude 'src/**/*.e2e.spec.ts'",
    "e2e": "playwright test --output node_modules/.cache/playwright-results",
    "lint": "oxlint --vue-plugin --import-plugin --deny-warnings src vite.config.ts playwright.config.ts",
    "format": "oxfmt --write src vite.config.ts playwright.config.ts package.json tsconfig.json index.html",
    "format:check": "oxfmt --check src vite.config.ts playwright.config.ts package.json tsconfig.json index.html",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm e2e"
  },
  "dependencies": {
    "vue": "3.5.35"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "6.0.7",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "tailwindcss": "^4.3.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "3.3.5"
  }
}
