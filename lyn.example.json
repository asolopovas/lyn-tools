{
  "hotkey": {
    "binding": "Ctrl+Space"
  },
  "cache": {
    "dir": ""
  },
  "scanner": {
    "roots": ["~/src", "~/www"],
    "maxDepth": 5,
    "concurrency": 0,
    "timeout": "20s",
    "watch": true
  },
  "ui": {
    "theme": "power-run",
    "backgroundOpacity": 0.98,
    "selectionColor": "#333333",
    "windowPlacement": "center",
    "clearQueryOnShow": true,
    "workspaceQueryShortcut": "{"
  },
  "startup": {
    "enabled": false,
    "startHidden": true
  }
}
